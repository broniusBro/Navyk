{
  "name": "navyk-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Navyk backend. Zero runtime dependencies: Node.js >= 22.18 (native fetch and TypeScript type stripping).",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "eval": "node --disable-warning=ExperimentalWarning src/reviewer/eval.ts",
    "start": "node --disable-warning=ExperimentalWarning src/http.ts",
    "backup": "node --disable-warning=ExperimentalWarning src/backup.ts"
  }
}
