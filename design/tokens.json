{
  "name": "Navyk · Тетрадь-конфетти (D)",
  "version": "1.0.1",
  "decided_at": "2026-10-13",
  "source": "Design canvas «Navyk — варианты стиля», artboard D",
  "principles": [
    "Тетрадь: бумага в точку, контурные карточки 2px чернилами, ключевые слова выделены маркером.",
    "Радость: каждому смыслу свой пастельный цвет; главное действие — один яркий оранжевый акцент.",
    "Цвет никогда не несёт смысл в одиночку: верно/неверно отличаются ещё иконкой, текстом и яркостью."
  ],
  "font": {
    "family": "Nunito",
    "stack": "Nunito, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "google_fonts": "https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap",
    "weights": {
      "body": 600,
      "strong": 800,
      "heading": 900
    },
    "size": {
      "caption": 13,
      "small": 14,
      "body": 16,
      "lead": 17,
      "h3": 19,
      "h2": 24,
      "h1": 30,
      "score": 26
    },
    "line_height": {
      "body": 1.45,
      "heading": 1.2
    }
  },
  "color": {
    "light": {
      "ink": "#22223B",
      "ink_muted": "#4A4A68",
      "ink_soft": "#5E5B7A",
      "paper": "#FFFDF8",
      "paper_dot": "#E4DDCF",
      "surface": "#FFFFFF",
      "frame": "#EDE6DA",
      "border": "#22223B",
      "border_soft": "#8E8BA8",
      "action": "#FFB020",
      "on_action": "#22223B",
      "action_shadow": "#22223B",
      "success": "#C9F2E0",
      "success_strong": "#7CD9B0",
      "highlight": "#FFF0A3",
      "streak": "#FFD6E7",
      "improve": "#FFD6E7",
      "brand_dot": "#FF5FA2",
      "info": "#CFE5FF",
      "repeat": "#E6DBFF",
      "wrong": "#FFD6E7",
      "focus": "#4078C4"
    },
    "dark": {
      "ink": "#F4F1EA",
      "ink_muted": "#C9C5D9",
      "ink_soft": "#A9A5BC",
      "paper": "#1C1B2B",
      "paper_dot": "#2E2C42",
      "surface": "#26253A",
      "frame": "#14131F",
      "border": "#CFCBE0",
      "border_soft": "#A9A5BC",
      "action": "#FFB020",
      "on_action": "#22223B",
      "action_shadow": "#000000",
      "success": "#1F4D3E",
      "success_strong": "#5CC79A",
      "highlight": "#5A4E1C",
      "streak": "#55253D",
      "improve": "#55253D",
      "brand_dot": "#FF7AB6",
      "info": "#1F3A5C",
      "repeat": "#3A2D66",
      "wrong": "#55253D",
      "focus": "#7DB8FF"
    }
  },
  "radius": {
    "chip": 12,
    "control": 16,
    "card": 20,
    "hero": 24,
    "node": 999
  },
  "border": {
    "default": 2,
    "strong": 3,
    "dashed_locked": "3px dashed"
  },
  "shadow": {
    "press_button": "0 5px 0 var(--action-shadow)",
    "press_card": "0 4px 0 var(--border)",
    "phone": "0 18px 40px rgba(34,34,59,0.14)"
  },
  "space": {
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 20,
    "xxl": 24
  },
  "touch_target_min": 44,
  "patterns": {
    "paper_background": "radial-gradient(var(--paper-dot) 1.3px, transparent 1.3px) 0 0 / 22px 22px, var(--paper)",
    "highlighter": "linear-gradient(transparent 55%, var(--highlight) 55%)",
    "sticker": "border 2px var(--border), small rotation -3deg, uppercase 13px/900 — для меток вроде «ТЫ ЗДЕСЬ»",
    "confetti": "4–5 небольших цветных точек/полосок (brand_dot, info, success_strong, repeat) только на экранах успеха; отключать при prefers-reduced-motion анимацию, но не сами точки"
  },
  "semantic_map": {
    "correct_answer": "success + border + иконка галочки + «Верно!»",
    "wrong_answer": "wrong + border + иконка крестика + «Не совсем»",
    "xp": "highlight",
    "streak": "streak",
    "to_improve_in_review": "improve",
    "daily_goal": "info",
    "spaced_repetition": "repeat",
    "exercise_type_tag": "repeat",
    "primary_button": "action / on_action + press_button"
  },
  "notes": [
    "1.0.1: focus #4D9DFF→#4078C4 (контраст 4.4:1), dark border_soft #6C6987→#A9A5BC (было 2.85:1) — по web/tools/contrast.mjs"
  ]
}